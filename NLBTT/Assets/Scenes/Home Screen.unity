  gameSceneName: GameScene
  overlayColor: {r: 0.5, g: 0, b: 0, a: 0.7}
  rulesContent: "SPIELREGELN\r\n\r\n<size=18>Steuerung:</size>\r\n\u2022 Klicke auf
    benachbarte Karten um dich zu bewegen\r\n\u2022 [1] - Hunger in Blutpunkte umwandeln\r\n\u2022
    [2] - Gesundheit in Blutpunkte umwandeln\r\n\u2022 [ENTER] - Blutpunkte am Altar
    deponieren\r\n\u2022 [ESC] - Spiel pausieren/fortsetzen\r\n\r\n<size=18>Spielziel:</size>\r\nSammle
    Blutpunkte und \xFCberlebe die Reise durch den Wald.\r\n\r\n<size=18>Ressourcen:</size>\r\n\u2022
    Terrain zieht dir Ausdauer ab\r\n\u2022 Bewegungen kosten Nahrung\r\n\u2022 Spezielle
    Karten verleihen dir Blutpunkte\r\n\u2022 Verwalte deine Ressourcen weise!\r\n\r\n<size=18>Tipps:</size>\r\n\u2022
    Plane deine Route sorgf\xE4ltig\r\n\u2022 Achte auf deine Ressourcen\r\n\u2022
    Nutze Blutpunkte strategisch"
  creditsContent: 'CREDITS

    

    <size=24>Entwickelt von</size>

    Katja
    & Lemuel

    

'
